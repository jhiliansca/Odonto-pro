  "author": "Richard Jimenez",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "setup": "npm run db:setup",
    "db:setup": "node seed/sembrarCatalogo.js && node seed/sembrarUsuarios.js && node seed/sembrarDatosOperativos.js && node seed/sembrarDatosDemo.js",
    "db:ensure": "node seed/asegurarEsquema.js",
    "db:seed": "node seed/sembrarCatalogo.js && node seed/sembrarUsuarios.js && node seed/sembrarDatosOperativos.js && node seed/sembrarDatosDemo.js",
    "db:users": "node seed/sembrarUsuarios.js",
    "db:operativos": "node seed/sembrarDatosOperativos.js",
    "db:demo": "node seed/sembrarDatosDemo.js",
    "db:schema": "node seed/sembrarCatalogo.js --solo-esquema",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "mysql": "^2.18.1",
    "mysql2": "^3.14.1",
    "nodemon": "^3.1.9"
  }
}
